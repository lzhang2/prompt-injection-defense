# Template for .env. Copy it and adjust:   cp .env.example .env
# .env is git-ignored. docker compose reads it automatically.
# No API keys go here: the Ray cluster mounts the app's configs/secrets.yaml.

# The image the Ray cluster runs. It must contain the code of the app deployed on
# it, so point it at the app image (built FROM ml-platform/ray-base).
RAY_IMAGE=genai-safety:latest

# CPUs Ray schedules with; training workers and Serve replicas share them.
RAY_NUM_CPUS=4

# Optional overrides (defaults shown):
# APP_SECRETS=../genai-safety/configs/secrets.yaml
# MLFLOW_HOST_PORT=5100
# SERVE_HOST_PORT=8100
# RAY_DASHBOARD_HOST_PORT=8365
